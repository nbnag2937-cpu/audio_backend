# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (Railway MySQL) ----
# Vi du Railway: mysql://root:password@host:port/railway
DATABASE_URL="mysql://user:password@localhost:3306/music_db"

# ---- JWT ----
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-bi-mat-that-dai-va-kho-doan"
JWT_EXPIRES_IN="7d"

# ---- Cloudflare R2 (tuong thich S3) ----
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="music-audio"
# Endpoint dang: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"
# Neu ban da bat Public Bucket / custom domain cho R2, dien vao day de tra ve link phat truc tiep
# Neu de trong, he thong se tu tao presigned URL (het han sau 1 gio)
R2_PUBLIC_BASE_URL=""

# ---- Ad unlock ----
# Link quang cao nguoi dung phai bam vao de mo khoa nghe nhac trong ngay
AD_LINK_URL="https://example.com/ads/sponsor"

# ---- Seed tai khoan Super Admin dau tien ----
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
SEED_SUPER_ADMIN_NAME="Super Admin"
