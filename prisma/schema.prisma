// Prisma schema - Music backend
// Chay: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum AudioStatus {
  PROCESSING
  READY
  FAILED
}

enum ListenEventType {
  START
  COMPLETE
}

model Account {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     Role
  isActive Boolean @default(true)

  createdById   String?
  createdBy     Account?  @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins Account[] @relation("AccountCreatedBy")

  audios Audio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

model Audio {
  id          String  @id @default(uuid())
  title       String  @db.VarChar(255)
  description String? @db.Text

  fileKey          String
  originalFileName String?
  mimeType         String?
  fileSize         Int?

  durationSec Int         @default(0)
  status      AudioStatus @default(PROCESSING)

  totalListening Int @default(0)
  totalListened  Int @default(0)

  adLinkUrl String? @db.VarChar(500)

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  listenEvents ListenEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("audios")
}

model ListenEvent {
  id        String          @id @default(uuid())
  audioId   String
  audio     Audio           @relation(fields: [audioId], references: [id], onDelete: Cascade)
  type      ListenEventType
  createdAt DateTime        @default(now())

  @@index([type, createdAt])
  @@index([audioId, type])
  @@map("listen_events")
}

model UnlockLog {
  id        String   @id @default(uuid())
  deviceId  String
  date      String
  createdAt DateTime @default(now())

  @@unique([deviceId, date])
  @@map("unlock_logs")
}
